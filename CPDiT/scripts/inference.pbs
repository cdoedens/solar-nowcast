#!/bin/bash -l
#PBS -N cpdft_inference
#PBS -q gpu
#PBS -l select=1:ngpus=1:gpu_type=V100
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o outputs/logs/inference.log

# PBS Job Script for inference with CPDiT on HPC cluster

# Load modules
module load cuda/11.8
module load pytorch/2.0.1

# Activate virtual environment
source /path/to/venv/bin/activate

# Set up directories
cd /path/to/CPDiT

# Run inference
echo "Starting CPDiT inference on GPU..."
python scripts/inference.py \
    --checkpoint outputs/checkpoints/best_model.pt \
    --data-paths /path/to/himawari/test/ \
    --forecast-steps 6 \
    --output-dir outputs/predictions \
    --device cuda

echo "Inference job completed!"
